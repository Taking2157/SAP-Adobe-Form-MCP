# MOCK: runnable with synthetic examples. SAP_BRIDGE: requires a real SAP read-only custom ICF/OData API.
PROVIDER=MOCK
HOST=127.0.0.1
PORT=3000
# REQUIRED: at least 24 random chars. Do not commit your real token.
MCP_AUTH_TOKEN=replace-with-a-random-token-at-least-24-chars
DEFAULT_DESTINATION=DEV100
DESTINATIONS_FILE=config/destinations.json
SAP_TIMEOUT_MS=10000
MAX_XDP_BYTES=1048576
# Only used in SAP_BRIDGE mode. Create read-only SAP service user with least privilege.
SAP_DEV100_USER=
SAP_DEV100_PASSWORD=
# Alternative to Basic: SAP_DEV100_TOKEN=<short-lived service token>
# For internal CA certificates: set NODE_EXTRA_CA_CERTS=<path to CA.pem> in your environment.
